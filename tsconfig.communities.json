{
  // Run by `pnpm test` (tsc --noEmit) so community type drift - an app type or
  // a jest fake that no longer matches the door contract - fails CI. Covers
  // src/screens/Community, src/features/communit*, the contract and its
  // fixtures, and every module that reads a door item or timeline page.
  "extends": "./tsconfig.json",
  "include": [
    "src/**/*.d.ts",
    "src/screens/Community",
    "src/features/communit*/**/*",
    "src/lib/communities",
    "src/lib/agent-runtime/communitiesClient.ts",
    "src/lib/api/feed/communities.ts",
    "src/lib/api/feed/__tests__/communities.test.ts",
    "src/view/com/composer/state/submit.ts",
    "src/view/com/composer/state/__tests__/submit.test.ts"
  ]
}

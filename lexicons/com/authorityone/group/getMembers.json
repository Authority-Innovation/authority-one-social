{
  "lexicon": 1,
  "id": "com.authorityone.group.getMembers",
  "description": "List the effective members of a group with resolved roles and statuses. Served by the Authority One AppView indexer.",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "params",
        "required": ["group"],
        "properties": {
          "group": {"type": "string", "format": "at-uri"},
          "status": {
            "type": "string",
            "description": "Optional filter to a single membership status (defaults to active).",
            "knownValues": [
              "com.authorityone.group.defs#active",
              "com.authorityone.group.defs#pending",
              "com.authorityone.group.defs#invited",
              "com.authorityone.group.defs#banned"
            ]
          },
          "limit": {"type": "integer", "minimum": 1, "maximum": 100, "default": 50},
          "cursor": {"type": "string"}
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["group", "members"],
          "properties": {
            "cursor": {"type": "string"},
            "group": {"type": "ref", "ref": "com.authorityone.group.defs#groupViewBasic"},
            "members": {
              "type": "array",
              "items": {"type": "ref", "ref": "com.authorityone.group.defs#memberView"}
            }
          }
        }
      },
      "errors": [
        {"name": "GroupNotFound"},
        {"name": "NotAuthorized"}
      ]
    }
  }
}
